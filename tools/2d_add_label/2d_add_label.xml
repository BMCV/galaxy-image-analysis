<tool id="2d_add_label" name="Add image label" version="@TOOL_VERSION@" profile="20.05">
    <description></description>
    <macros>
        <import>creators.xml</import>
        <import>fp_conversion.xml</import>
        <import>validators.xml</import>
        <import>tests.xml</import>
        <token name="@TOOL_VERSION@">0.1</token>
    </macros>
    <creator>
        <expand macro="creators/bmcv"/>
        <expand macro="creators/kostrykin"/>
    </creator>
    <edam_operations>
        <edam_operation>operation_3443</edam_operation>
    </edam_operations>
    <xrefs>
        <xref type="bio.tools">galaxy_image_analysis</xref>
    </xrefs>
    <requirements>
        <requirement type="package" version="3.11.1">matplotlib</requirement>
        <requirement type="package" version="2.5.3">numpy</requirement>
        <requirement type="package" version="0.7.3">giatools</requirement>
    </requirements>
    <required_files>
        <include path="2d_add_label.py" />
    </required_files>
    <command detect_errors="aggressive">
    <![CDATA[

        python '$__tool_directory__/2d_add_label.py'

        #if $input_image.extension == "zarr"
            --input_image '$input_image.extra_files_path/$input_image.metadata.store_root'
        #else
            --input_image '$input_image'
        #end if

        --output_image '$output_image'
        --params '$params'
        --verbose

    ]]>
    </command>
    <configfiles>
        <configfile name="params"><![CDATA[
            {
                @DEFAULT_FP_CONVERSION_JSON@,
                "label_text": "$label_text",
                "position_h": "$position.horizontal",
                "position_v": "$position.vertical",
                "padding": $position.padding,
                "label_text_color": "$style.text_color",
                "label_background_color": "$style.background_color",
                "label_background_opacity": $style.background_opacity,
                "text_params": {
                    "fontsize": $style.fontsize,
                    "fontweight": "$style.fontweight"
                }
            }
        ]]></configfile>
    </configfiles>
    <inputs>
        <param name="input_image" type="data" format="zarr,tiff,png,jpg" label="Input image">
            <expand macro="validators/has_number_of_channels" allowed_numbers="0,1,3,4"/><!-- single-channel (0, 1), RGB (3), RGBA (4) -->
            <expand macro="validators/is_single_frame"/>
            <expand macro="validators/is_2d"/>
        </param>
        <expand macro="fp_conversion/section"/>
        <param name="label_text" type="text" label="Label text" optional="false"/>
        <section name="position" title="Label position" expanded="true">
            <param name="vertical" type="select" label="Vertical position">
                <option value="above">Above the image</option>
                <option value="below" selected="True">Below the image</option>
                <option value="top">Top of the image</option>
                <option value="bottom">Bottom of the image</option>
            </param>
            <param name="horizontal" type="select" label="Horizontal position">
                <option value="left">Left of the image</option>
                <option value="center">Center of the image</option>
                <option value="right" selected="True">Right of the image</option>
            </param>
            <param name="padding" type="integer" value="3" min="0" label="Padding (in pixels)"
                help="Governs the offset of the label from the above-configured position."/>
        </section>
        <section name="style" title="Label appearance" expanded="true">
            <param name="fontsize" type="integer" value="12" min="1" label="Font size" />
            <param name="fontweight" type="boolean" truevalue="bold" falsevalue="normal" value="false" label="Bold"/>
            <param name="text_color" type="color" value="#000000" label="Text color"/>
            <param name="background_color" type="color" value="#ffffff" label="Background color"/>
            <param name="background_opacity" type="float" min="0" max="1" value="1" label="Background opacity" help="Set to 0 to fully suppress the label background."/>
        </section>
    </inputs>
    <outputs>
        <data name="output_image" format="png" from_work_dir="output.png" label="${tool.name} &quot;${label_text}&quot; on ${on_string}"/>
    </outputs>
    <tests>
        <test>
            <param name="input_image" value="input/input5.jpg"/>
            <param name="label_text" value="The label"/>
            <section name="position">
                <param name="vertical" value="below"/>
                <param name="horizontal" value="left"/>
            </section>
            <section name="style">
                <param name="fontsize" value="4"/>
                <param name="background_color" value="#ffff00"/>
            </section>
            <expand macro="tests/intensity_image_diff" name="output_image" value="output/input5_below_left.png" ftype="png"/>
        </test>
        <test>
            <param name="input_image" value="input/input6_yx.zarr"/>
            <param name="label_text" value="The label"/>
            <section name="position">
                <param name="vertical" value="top"/>
                <param name="horizontal" value="center"/>
                <param name="padding" value="20"/>
            </section>
            <section name="style">
                <param name="fontweight" value="bold"/>
                <param name="text_color" value="#ff0000"/>
                <param name="background_color" value="#00ffff"/>
                <param name="background_opacity" value="0.5"/>
            </section>
            <expand macro="tests/intensity_image_diff"
                name="output_image" value="output/input6_top_center_fp-0-1.png" ftype="png"/>
        </test>
        <test>
            <param name="input_image" value="input/input6_yx.zarr"/>
            <section name="fp_conversion">
                <param name="lower" value="min"/>
                <param name="upper" value="max"/>
            </section>
            <param name="label_text" value="The label"/>
            <section name="position">
                <param name="vertical" value="bottom"/>
                <param name="horizontal" value="right"/>
                <param name="padding" value="20"/>
            </section>
            <expand macro="tests/intensity_image_diff"
                name="output_image" value="output/input6_bottom_right_fp-min-max.png" ftype="png"/>
        </test>
        <test>
            <param name="input_image" value="input/input11.tiff"/>
            <param name="label_text" value="The label"/>
            <section name="position">
                <param name="vertical" value="above"/>
                <param name="horizontal" value="center"/>
            </section>
            <section name="style">
                <param name="text_color" value="#0000ff"/>
                <param name="background_opacity" value="0"/>
            </section>
            <expand macro="tests/intensity_image_diff" name="output_image" value="output/input11_above_center.png" ftype="png"/>
        </test>
    </tests>
    <help><![CDATA[

        **Adds a label text to a 2-D image.**

        The input image can be single-channel or multi-channel. For a multi-channel image, it is required that the image channels are either RGB or RGBA.

    ]]></help>
    <citations>
        <citation type="doi">10.1016/j.jbiotec.2017.07.019</citation>
    </citations>
</tool>
